# Backend environment. Copy to backend/.env and fill in. Never commit the real file.

NODE_ENV=development
PORT=4000
# The ONE database URL (Neon). The pooled string (host contains "-pooler") is recommended; the
# direct one also works. Migrations derive the direct address from it automatically.
DATABASE_URL=
# 32+ random bytes: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Allowed Origin for state-changing requests and CORS
APP_ORIGIN=http://localhost:5173
# A SEPARATE Neon database (e.g. create database stockflow_test) or Neon branch. NEVER the dev DB:
# tests empty its tables. No local databases are used in this project.
TEST_DATABASE_URL=

# Number of reverse proxies in front of the API (default 1: the Vite dev proxy).
# Production behind Vercel rewrite + Render load balancer = 2 (render.yaml sets this).
# TRUST_PROXY_HOPS=1
