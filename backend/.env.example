# Backend environment. Copy to backend/.env and fill in. Never commit the real file.

NODE_ENV=development
PORT=4000
# Neon POOLED connection string (runtime)
DATABASE_URL=
# Neon DIRECT connection string (migrations)
DIRECT_URL=
# 32+ random bytes: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Allowed Origin for state-changing requests and CORS
APP_ORIGIN=http://localhost:5173
# Separate Neon branch or local docker postgres, NEVER the dev DB
TEST_DATABASE_URL=
