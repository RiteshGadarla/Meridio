// FILE: backend/prisma/schema.prisma
// PURPOSE: Database schema for StockFlow (tenant-scoped inventory).
//
// PRISMA VERSION: pinned to 7.10.1 (exact). Reason: the Prisma 8 line is still release-candidate,
// and 7.x is the current stable major. Prisma 7 requires:
//   - a driver adapter at runtime (@prisma/adapter-pg, see src/lib/prisma.ts), connected to
//     DATABASE_URL (the Neon pooled url works best);
//   - connection settings for the CLI in prisma.config.ts, which derives the direct (non-pooled)
//     form of the same DATABASE_URL for migrations, so there is no `url`/`directUrl` in the
//     datasource block below;
//   - the `prisma-client` generator with an explicit output folder (generated code is gitignored).
//
// CHECK constraints and pg_trgm search indexes cannot be expressed in this file. They live in the
// raw SQL migration `*_constraints_and_search_indexes`. Do not remove them when editing the schema.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // WHY: the backend compiles with NodeNext modules, which needs explicit .js import extensions.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// An organization is the tenant. Every business row hangs off one organization, and every query
// must filter by organizationId (TENANT SCOPE).
model Organization {
  id                       String   @id @default(cuid())
  name                     String
  // Fallback low-stock threshold for products with no threshold of their own.
  // CHECK >= 0 (see raw SQL migration).
  defaultLowStockThreshold Int      @default(5)
  // Avatar look ({from,to,angle,symbol}) chosen at creation. Null on older rows (UI shows white on black).
  avatar                   Json?
  // Display currency (ISO 4217 code). Money is stored as plain decimals; this only affects formatting.
  currency                 String   @default("INR")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  users    User[]
  products Product[]
  activity ActivityLog[]
}

// A person who can sign in. MVP: exactly one owner per organization.
// DECISION: organizationId is a plain FK (NOT @unique) so multi-user orgs become a future
// migration with no schema change. The one-user-per-org rule is enforced in the signup service.
model User {
  id             String       @id @default(cuid())
  // Stored lowercase and trimmed by the app, so the plain @unique is effectively case-insensitive.
  email          String       @unique
  // Null for accounts created through Google sign-in (they have no password). Password login
  // for such an account always fails with the generic credentials error.
  passwordHash   String?
  // Google account id (the OIDC `sub`). Unique so one Google account maps to one user.
  googleId       String?      @unique
  // Display name and avatar URL from Google (or null for password accounts).
  name           String?
  pictureUrl     String?
  // Initial-tile gradient ({from,to,angle,symbol}) chosen at creation. Null on older rows.
  avatar         Json?
  organizationId String
  // Cascade: deleting an organization removes its users too.
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  updatedProducts Product[]
  activity        ActivityLog[]

  @@index([organizationId])
}

// A stock-keeping item owned by one organization.
model Product {
  id                String       @id @default(cuid())
  organizationId    String
  // Cascade: deleting an organization removes its catalogue.
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  // SKU is trimmed and uppercased by the app. Unique per organization (see @@unique below), so two
  // different tenants can both use "KEY-001".
  sku               String
  description       String?
  // CHECK >= 0 (raw SQL migration) as a safety net even if application code has a bug.
  quantityOnHand    Int          @default(0)
  // WHY Decimal(12,2): money must never be a float (19.99 would drift). Optional per the PRD.
  costPrice         Decimal?     @db.Decimal(12, 2)
  sellingPrice      Decimal?     @db.Decimal(12, 2)
  // null = "use the organization default". An explicit 0 is a real override (not the same as null).
  lowStockThreshold Int?
  // Who last changed the product. SetNull so deleting a user never deletes inventory history.
  updatedById       String?
  updatedBy         User?        @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([organizationId, sku])
  @@index([organizationId, createdAt])
  @@index([organizationId, name])
  // pg_trgm indexes for ILIKE '%x%' search. Created in the raw SQL migration; declared here only so
  // Prisma's drift detection does not try to drop them.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_name_trgm_idx")
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_sku_trgm_idx")
}

// What kind of change an activity entry records.
enum ActivityAction {
  PRODUCT_CREATED
  PRODUCT_UPDATED
  STOCK_ADJUSTED
  PRODUCT_DELETED
}

// A short, human-readable line per inventory change, shown in the sidebar feed. This is a basic
// activity feed, NOT an audit trail or movement ledger (both are out of scope in the PRD).
// DECISION: productId is a plain string (no FK) and name/SKU are copied in, so an entry still reads
// correctly after its product has been deleted.
model ActivityLog {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // SetNull so removing a user never deletes the feed.
  userId         String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         ActivityAction
  productId      String?
  productName    String
  productSku     String
  // Ready-to-display sentence, for example "Adjusted stock by -5 (12 → 7)".
  summary        String
  // Optional free-text note from the "Adjust stock" control.
  note           String?
  createdAt      DateTime       @default(now())

  @@index([organizationId, createdAt])
}
